# Fine-grained token with Actions: read & write on the audit repo
GITHUB_TOKEN=
GITHUB_OWNER=o8o0o8o
GITHUB_REPO=audit-tool
GITHUB_WORKFLOW=audit.yml
GITHUB_REF=main
# Optional: when set, users must enter this access key on the form to dispatch an audit.
# Leave empty for a public dispatcher (anyone can spend your Actions minutes and API keys).
DISPATCH_SECRET=
# Optional: max dispatches per client IP per hour, per server instance (default 5)
DISPATCH_RATE_LIMIT=5
# Vercel Blob store token (set automatically when a Blob store is linked to the project)
BLOB_READ_WRITE_TOKEN=
