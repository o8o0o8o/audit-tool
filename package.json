{
  "name": "audit-tool",
  "version": "1.0.0",
  "description": "Automated SEO audit tool",
  "main": "robots.ts",
  "bin": {
    "seo-audit": "./start.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "audit": "tsx start.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,json,md}'",
    "format:check": "prettier --check '**/*.{ts,json,md}'",
    "test": "tsx --test 'tests/**/*.test.ts'"
  },
  "author": "Sergey Labut",
  "license": "ISC",
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "marked": "^18.0.4",
    "node-html-parser": "^6.1.13",
    "playwright": "^1.49.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
