# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist

# audit results
/http*
SEOAnalysis*
failedPages.json
audit-results
# Generated reports/sitemaps land at the repo root or under audit-results/.
# Scope the ignore there so committed test fixtures (tests/fixtures/**.html,
# sample sitemaps) aren't silently excluded by a bare `*.html` / `*.xml`.
/*.html
/*.xml
/audit-results/**/*.html
/audit-results/**/*.xml

# dual lockfile — this project uses yarn
package-lock.json

# local fix/review patch notes
.patches
# web dispatcher (Next.js on Vercel)
web/.next
web/node_modules

# Generated brand preview of the HTML report (yarn run preview:report)
web/public/report/
